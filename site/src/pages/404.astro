---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="This page does not exist.">
  <div class="wrap center-page">
    <h1>That bubble popped.</h1>
    <p>There is no page at this address. It may have moved or never existed.</p>
    <div class="btn-row">
      <a class="btn primary" href="/">Go to the home page</a>
      <a class="btn" href="/docs/">Browse the docs</a>
    </div>
  </div>
</Base>
