---
interface Props { mode: "declarative" | "worker" | "frame" }
const { mode } = Astro.props;
---
<svg viewBox="0 0 76 76" aria-hidden="true" focusable="false">
  {mode === "declarative" && (
    <>
      <circle cx="38" cy="38" r="27" fill="var(--bubble-fill)" stroke="url(#film)" stroke-width="3.5" />
      <path d="M26 34h24M26 42h16" stroke="var(--ink-2)" stroke-width="3" stroke-linecap="round" />
    </>
  )}
  {mode === "worker" && (
    <>
      <rect x="6" y="6" width="64" height="64" rx="10" fill="none" stroke="var(--ink-2)" stroke-width="2" stroke-dasharray="4 4" />
      <circle cx="38" cy="38" r="20" fill="var(--bubble-fill)" stroke="url(#film)" stroke-width="3.5" />
      <text x="38" y="43" text-anchor="middle" font-family="monospace" font-size="13" fill="var(--ink)">{"</>"}</text>
    </>
  )}
  {mode === "frame" && (
    <>
      <rect x="9" y="12" width="58" height="52" rx="6" fill="var(--bubble-fill)" stroke="var(--ink)" stroke-width="3" />
      <path d="M9 24h58" stroke="var(--ink)" stroke-width="3" />
      <circle cx="17" cy="18" r="1.8" fill="var(--ink)" /><circle cx="24" cy="18" r="1.8" fill="var(--ink)" />
    </>
  )}
</svg>
